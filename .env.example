# Configuration for es-rolling-restart.sh
# Copy to .env (next to the script) and restrict permissions:  chmod 600 .env

# Elasticsearch endpoints (comma-separated; the next one is tried if a node is down)
ES_URL=https://es01:9200,https://es02:9200,https://es03:9200

# Authentication (preferred: a file containing only the secret, mode 600/400)
ES_API_KEY_FILE=/etc/es-restart/es-api-key
#ES_API_KEY=                 # inline API key (less secure)
#ES_USER=elastic
#ES_PASS_FILE=/etc/es-restart/es-pass
#ES_PASS=

# TLS
ES_CACERT=/etc/elasticsearch/certs/http_ca.crt
#INSECURE=0

# SSH access to the nodes
SSH_USER=esadmin
#SSH_HOST_FROM=ip
#SERVICE=elasticsearch

# Optional, 'restart' command only: explicit node list (space-separated); empty = all nodes
#NODES="es01 es02 es03"

# 'post': start the service if it is not running after maintenance (1) or only wait for it (0)
#POST_START=1

# Timeouts (seconds)
#WAIT_LEAVE_TIMEOUT=300      # stopped node leaving the cluster
#WAIT_SSH_TIMEOUT=1800       # 'post': host reachable over SSH again (reboot after patching)
#WAIT_NODE_TIMEOUT=1800      # node rejoining the cluster
#WAIT_GREEN_TIMEOUT=3600     # cluster back to GREEN
#POLL=10

# Unattended execution
#FORCE=1
